# Set ONE of these in your terminal (see README). Gemini has a free tier.
GEMINI_API_KEY=your-key-from-aistudio.google.com
# ANTHROPIC_API_KEY=your-key-here        # paid alternative

# Optional. Default Gemini model is gemini-3.8-flash. Use any model your key can access.
# LESSONFORGE_GENERATOR_MODEL=gemini-3.8-flash
# LESSONFORGE_JUDGE_MODEL=gemini-3.8-flash
